# Copy to .env and edit. NEVER commit .env. Placeholder values only in this file.

# SQLite database file (gitignored). Path is relative to the project root.
DATABASE_URL=file:./data/houcine-trades.db

# Trading mode. Only "paper" is allowed for now (real execution does not exist yet).
TRADING_MODE=paper

# ---- Authentication (module 4). See docs/security.md. ----
# REQUIRED to log in. Generate your own with:  npm run auth:generate-secret
# Keep it private, back it up, and never commit .env. If you lose it, the authenticator secret
# can no longer be read and you must re-enrol with:  npm run auth:reset
AUTH_SECRET=replace-with-the-output-of-the-generate-command-see-docs-security

# Session lifetime (optional). Idle: 5-480 minutes. Absolute: 1-72 hours.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Set to true ONLY behind a reverse proxy you control (module 8). Leave false on your own computer.
TRUST_PROXY=false

# ---- Claude analyst (module 6). See docs/analyst.md. ----
# Leave the key EMPTY here. Put your real key in .env with:  npm run ai:set-key
# (the script asks for it with hidden input and never prints it). Without a key the analyst is
# simply off and the rest of the app works as before.
ANTHROPIC_API_KEY=
# The model the analyst uses. It MUST be listed in src/domain/analyst/pricing.ts (a test checks
# it), otherwise costs cannot be estimated and the analyst stays off.
ANALYST_MODEL=claude-sonnet-5-5

# ---- Telegram alerts (module 7). See docs/notifications.md. ----
# Leave both EMPTY here. Put the real values in .env with:  npm run notify:set-telegram
# (hidden input; it also pairs your chat). Without them alerts simply stay off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Hosting (module 8). See docs/deploy.md. ----
# These are for the HOSTED app only. Set them in the hosting platform's secret store, NEVER in a file
# on your computer that you commit. They are commented out here on purpose: on your own computer
# nothing below is needed, and HOSTED must not be set.
#
# HOSTED=true                       (the container image sets it; makes the start-up checks mandatory)
# DATA_DIR=/var/data                (where the persistent disk is mounted)
# DATABASE_URL=file:/var/data/houcine-trades.db
# TRUST_PROXY=true                  (must be set explicitly when hosted; a NEW AUTH_SECRET too)
# BACKUP_KEY=                       (make one with: npm run backup:generate-key; keep a copy in your password manager)
# S3_ENDPOINT=                      (https address of your S3-compatible storage, no path)
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=backups                 (optional folder inside the bucket)
