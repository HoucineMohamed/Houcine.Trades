# Copy to .env and edit. NEVER commit .env. Placeholder values only in this file.

# SQLite database file (gitignored). Path is relative to the project root.
DATABASE_URL=file:./data/houcine-trades.db

# Trading mode. Only "paper" is allowed for now (real execution does not exist yet).
TRADING_MODE=paper

# ---- Authentication (module 4). See docs/security.md. ----
# REQUIRED to log in. Generate your own with:  npm run auth:generate-secret
# Keep it private, back it up, and never commit .env. If you lose it, the authenticator secret
# can no longer be read and you must re-enrol with:  npm run auth:reset
AUTH_SECRET=replace-with-the-output-of-the-generate-command-see-docs-security

# Session lifetime (optional). Idle: 5-480 minutes. Absolute: 1-72 hours.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Set to true ONLY behind a reverse proxy you control (module 8). Leave false on your own computer.
TRUST_PROXY=false
